<?xml version="1.0" encoding="utf-8" ?>
<xs:schema id="DS_Centri" targetNamespace="http://tempuri.org/DS_Centri.xsd" elementFormDefault="qualified"
	attributeFormDefault="qualified" xmlns="http://tempuri.org/DS_Centri.xsd" xmlns:mstns="http://tempuri.org/DS_Centri.xsd"
	xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
	<xs:element name="DS_Centri" msdata:IsDataSet="true">
		<xs:complexType>
			<xs:choice maxOccurs="unbounded">
				<xs:element name="DS_Centri">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Piva" type="xs:string"></xs:element>
							<xs:element name="Sa_Cod" type="xs:int"></xs:element>
							<xs:element name="Sa_Nome" type="xs:string"></xs:element>
							<xs:element name="Indirizzo" type="xs:string"></xs:element>
							<xs:element name="CAP" type="xs:string"></xs:element>
							<xs:element name="Comune" type="xs:string"></xs:element>
							<xs:element name="Provincia" type="xs:string"></xs:element>
							<xs:element name="Recapiti" type="xs:string"></xs:element>
							<xs:element name="Codice" type="xs:string" minOccurs="0" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>
</xs:schema>