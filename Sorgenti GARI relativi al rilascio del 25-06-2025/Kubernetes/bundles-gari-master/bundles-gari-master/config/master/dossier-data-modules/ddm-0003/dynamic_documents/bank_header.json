{
    "code": "bank_header",
    "version": "0.0.3",
    "description": "Attestazione Bancaria",
    "title": {
        "en": "Bank Header",
        "it": "Attestazione Bancaria"
    },
    "metadata": {
        "maxOccurs": 1,
        "timeOverlap": false,
        "defaultLocale": "it",
        "startDateField": "01-11-2023",
        "endDateField": "31-12-9999"
    },
    "onSaveApiCalls": [
        {
            "when": "creating", 
            "url": "http://fvg-dossier-server:8080/fvg-dossier-server/{tenant}/public/v1/unique-code"
        }
    ],
    "fieldSets": [
        {
            "code": "attachments",
            "minOccurs": 1,
            "maxOccurs": 999,
            "label": {
                "en": "attachments",
                "it": "Allegati"
            },
            "fields": [
                {
                    "code": "document_attachment_type",
                    "required": true,
                    "label": {
                        "en": "Document type",
                        "it": "Tipologia Allegato"
                    },
                    "type": "string",
                    "lookupCode": "document_attachment_type_lookup"
                },
                {
                    "code": "attachment_file",
                    "required": true,
                    "label": {
                        "en": "Attachment",
                        "it": "Allegato"
                    },
                    "type": "file"
                }
            ]
        },
        {
            "code": "bank_header_related_data",
            "minOccurs": 1,
            "maxOccurs": 1,
            "label": {
                "en": "Bank Header Related Data",
                "it": "Dati Relativi all'Attestazione Bancaria"
            },
            "fields": [
                {
                    "code": "subscription_date",
                    "required": true,
                    "label": {
                        "en": "Subscription date",
                        "it": "Data sottoscrizione"
                    },
                    "type": "date"
                },
                {
                    "code": "note",
                    "required": false,
                    "label": {
                        "en": "Notes",
                        "it": "Note"
                    },
                    "type": "string",
                    "style": "textarea"
                }
            ]
        },
        {
            "code": "Unique",
            "minOccurs": 1,
            "maxOccurs": 1,
            "label": {
                "en": "Unique Code Data",
                "it": "Dati del Codice Univoco"
            },
            "fields": [
                {
                "code": "uniqueCode",
                "label": {
                    "en": "Unique Code",
                    "it": "Codice Univoco"
                },
                "required": false,
                "type": "string",
                "readonly": true
                },
                {
                "code": "uniqueCodeDate",
                "label": {
                    "en": "Release Date",
                    "it": "Data Rilascio"
                },
                "required": false,
                "type": "string",
                "readonly": true
                }
            ]
        }
    ],
    "lookups": [
        {
            "code": "document_attachment_type_lookup",
            "entries": [
                {
                    "code": "bank_statement",
                    "label": {
                        "en": "STATEMENT FROM THE BANK IN WHICH THE C/C IS HELD",
                        "it": "DICHIARAZIONE DELL'ISTITUTO BANCARIO DI INTESTAZIONE DEL C/C"
                    }
                },
                {
                    "code": "account_agreement",
                    "label": {
                        "en": "CURRENT ACCOUNT AGREEMENT",
                        "it": "CONTRATTO DI CONTO CORRENTE"
                    }
                },
                {
                    "code": "statement_header",
                    "label": {
                        "en": "STATEMENT HEADER FOR CURRENT ACCOUNT SUMMARY",
                        "it": "INTESTAZIONE DELL'ESTRATTO PER RIASSUNTO DI CONTO CORRENTE"
                    }
                }
            ]
        }
    ]
}