{
    "code": "INPS_REGISTRATION",
    "version": "0.1.2",
    "description": "Iscrizione INPS",
    "title": {
        "en": "INPS registration",
        "it": "Iscrizione INPS"
    },
    "metadata": {
        "maxOccurs": 1,
        "timeOverlap": false,
        "defaultLocale": "it",
        "startDateField": "01-11-2023",
        "endDateField": "31-12-9999"
    },
    "fieldSets": [
        {
            "code": "INPS_REGISTRATION_YEAR_1",
            "minOccurs": 1,
            "maxOccurs": 1,
            "label": {
                "en": "Year 1",
                "it": "Anno 1"
            },
            "fields": [
                {
                    "code": "type_year_1",
                    "required": true,
                    "label": {
                        "en": "",
                        "it": "Tipologia"
                    },
                    "type": "string",
                    "style": "radio",
                    "lookupCode": "type_lookup"
                },
                {
                    "code": "INPS_office_year_1",
                    "required": true,
                    "label": {
                        "en": "",
                        "it": "Sede INPS competente"
                    },
                    "type": "string"
                },
                {
                    "code": "year_year_1",
                    "required": true,
                    "label": {
                        "en": "",
                        "it": "Anno"
                    },
                    "type": "string",
                    "validation": [
                        {
                            "operator": "regex",
                            "expression": "^(19[0-9]{2}|20[01][0-9]|202[0-3])$",
                            "errorMessage": {
                                "en": "The year must be less than 2024",
                                "it": "L'anno deve essere compreso tra il 1900 ed il 2024 escluso"
                            }
                        }
                    ]
                }
            ]
